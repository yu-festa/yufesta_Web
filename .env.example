# Spring Boot API origin used by the browser client.
VITE_API_BASE_URL=https://api.yufesta.com

# npx web-push generate-vapid-keys 명령으로 한 번 생성한 키 쌍을 사용합니다.
# Vercel 프로젝트의 Settings > Environment Variables에 같은 이름으로 등록하세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 선택 사항: 발송자 연락처 URL 또는 mailto 주소. 생략하면 현재 사이트 주소를 사용합니다.
VAPID_SUBJECT=

# Kakao Maps JavaScript key (register local and production SDK domains in Kakao Developers).
VITE_KAKAO_MAP_KEY=

# Explicitly opt in only when local UI preview data is needed.
VITE_PROFILE_PREVIEW=false
