# Spring Boot API origin. Development requests use the Vite proxy; production calls this origin directly.
VITE_API_BASE_URL=https://api.yufesta.com
# Local API + cookie proxy, enabled by default. Restart npm run dev after changing these values.
VITE_DEV_API_PROXY=true

# npx web-push generate-vapid-keys 명령으로 한 번 생성한 키 쌍을 사용합니다.
# Vercel 프로젝트의 Settings > Environment Variables에 같은 이름으로 등록하세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 선택 사항: 발송자 연락처 URL 또는 mailto 주소. 생략하면 현재 사이트 주소를 사용합니다.
VAPID_SUBJECT=

# Vercel server variables for scheduled push (never use the VITE_ prefix).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUSH_PUBLIC_ORIGIN=https://yufesta.com
PUSH_OPEN_AT=2026-09-26T18:30:00+09:00
# test sends a test message; opening announces the actual festival opening.
PUSH_OPEN_MODE=test

# Kakao Maps JavaScript key (register local and production SDK domains in Kakao Developers).
VITE_KAKAO_MAP_KEY=

# Explicitly opt in only when local UI preview data is needed.
VITE_PROFILE_PREVIEW=false
